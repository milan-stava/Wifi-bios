408   FEFA ED 78        		in	a,(c)
409   FEFC CB 47        		bit	status_data1,a		;Z = no byte to receive, NZ = byte to receive
410   FEFE 30 06        		jr	nc,rece_stat		;NC = read status only, jump to carry setting
411   FF00 28 04        		jr	z,rece_stat		;Z = no byte to receive
412   FF02
413   FF02 04           		inc	b			;B = high RX_SETBAUD
414   FF03 ED 58        		in	e,(c)			;receive byte
