390   FEEA 37           		scf			;CY=1, Z=0
391   FEEB
392   FEEB 7A           spd_found	ld	a,d		;; A = found index of speed
393   FEEC 2B           read_item	dec	hl		;; HL = found item in baud speed table
394   FEED 5E           		ld	e,(hl)
