305   FE80
306   FE80 CD 75 FE     turnon_wifi2	call	turn_sub
307   FE83 CB 47        		bit	0,a
308   FE85 D0           		ret	nc		;OUT=Z/NZ
309   FE86              ;		ld	a,1
