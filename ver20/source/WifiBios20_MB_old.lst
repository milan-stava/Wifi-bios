416   FF06
417   FF06              rece_stat	DUP	status_full+1
418   FF06 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
418   FF07 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
418   FF08 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
419   FF09              		EDUP
