381   FEDE 23           		inc	hl
382   FEDF 23           		inc	hl
383   FEE0 23           		inc	hl
384   FEE1 14           		inc	d
385   FEE2 BE           		cp	(hl)
386   FEE3 28 06        		jr	z,spd_found	;If code found, CY=0 & Z=1
387   FEE5 CB 7E        		bit	7,(hl)
388   FEE7 28 F4        		jr	z,search_loop
