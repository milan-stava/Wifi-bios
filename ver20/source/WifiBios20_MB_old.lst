425   FF0B              ;; Transmit one byte
426   FF0B
427   FF0B C5           sending_byte	push	bc
428   FF0C D5           		push	de
429   FF0D 5F           		ld	e,a		;E= byte to send
430   FF0E 01 3B 13     		ld	bc,TX_CHKREADY
431   FF11 ED 78        		in	a,(c)		;does not change carry
