338   FEA6 1E 00        set_baud_rate	ld	e,#00		;; We have 24 speeds on ESP01 in MB03 so far
339   FEA8 43           		ld	b,e		;; in case of error speed 0 will be returned
340   FEA9 4B           		ld	c,e
341   FEAA CB 1A        		rr	d		;; Bit 7,d: 0=Info / 1=Set
342   FEAC 6F           		ld	l,a		;; L = requested speed index
343   FEAD 3E 17        max_index	ld	a,23		;; A = max supported speed index (23 since 2.0)
344   FEAF              ;max_index	ld	a,#55		;; A = max supported speed index (7,12,23)
345   FEAF BD           		cp	l
346   FEB0 D8           		ret	c		;; Return with CY=1 if speed index overflows max speed
347   FEB1
348   FEB1 01 87 FF     add_spdtab1	ld	bc,spdtab+3
349   FEB4 26 00        		ld	h,#00
350   FEB6 29           		add	hl,hl
351   FEB7 29           		add	hl,hl
352   FEB8 09           		add	hl,bc		; CY=0
353   FEB9 7E           		ld	a,(hl)		; A = HW byte for speed
354   FEBA
