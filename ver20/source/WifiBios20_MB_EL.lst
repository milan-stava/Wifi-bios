242   FE4A
243   FE4A ~            /*actually el detection not needed
244   FE4A ~            		ld	bc,element_port		;#783B, detect if el connected (D=NZ)
245   FE4A ~            		ld	a,#ff
246   FE4A ~            		out	(c),a
247   FE4A ~            		inc	b
248   FE4A ~            		in	a,(c)			;should return 225, if el connected
249   FE4A ~            		and	%11110000
250   FE4A ~            		cp	#E0
251   FE4A ~            		jr	z,ig_el			;Z=el detected
252   FE4A ~
253   FE4A ~            		xor	a
254   FE4A ~
255   FE4A ~            ig_el		ld	d,a			;D=either #E0 or 0
256   FE4A ~            */
257   FE4A
258   FE4A 01 3B 70     		ld	bc,mb03_port		;#703B, detect if mb connected (E=NZ)
259   FE4D 3E FF        		ld	a,#FF
260   FE4F ED 79        		out	(c),a
261   FE51 06 77        		ld	b,high ZXi_port7	;#773B
262   FE53 ED 78        		in	a,(c)			;should return 51, if mb connected
263   FE55 E6 F0        		and	#F0
264   FE57 FE 30        		cp	#30
265   FE59 28 01        		jr	z,ig_mb
266   FE5B
267   FE5B AF           		xor	a
268   FE5C
269   FE5C 5F           ig_mb		ld	e,a			;E=either #30 or 0
270   FE5D 32 76 FE     ig_mb1		ld	(t_off_w+1),a
271   FE60
272   FE60
273   FE60 3E 17        		ld	a,23			;new in 2.0 max speed always 23
274   FE62              ;set_max_idx	ld	(max_index+1),a
275   FE62
276   FE62 21 E8 FF     add_biosid	ld	hl,bios_id
277   FE65 DD 2E 0C     		ld	lx,num_of_calls
