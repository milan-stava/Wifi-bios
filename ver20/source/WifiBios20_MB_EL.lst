321   FE94
322   FE94 01 3B 7C     clear_loop2	ld	bc,general_port	;fast clear receive buffer
323   FE97 3E 30        		ld	a,#30
324   FE99 ED 79        		out	(c),a
325   FE9B 3E 01        		ld	a,1
326   FE9D 04           		inc	b
327   FE9E ED 79        		out	(c),a
328   FEA0
329   FEA0 3E 13        clear_loop1	ld	a,high TX_CHKREADY
330   FEA2 DB 3B        		in	a,(low TX_CHKREADY)
331   FEA4 0F           		rrca
332   FEA5 D0           		ret	nc
333   FEA6 3E 14        		ld	a,high RX_SETBAUD
334   FEA8 DB 3B        		in	a,(low RX_SETBAUD)
335   FEAA 18 F4        		jr	clear_loop1
336   FEAC
337   FEAC
338   FEAC
339   FEAC              ;; Set/Get baud rate
340   FEAC
341   FEAC 1E 00        set_baud_rate	ld	e,#00		;; We have 24 speeds on ESP01 in MB03 so far
342   FEAE 43           		ld	b,e		;; in case of error speed 0 will be returned
343   FEAF 4B           		ld	c,e
344   FEB0 CB 1A        		rr	d		;; Bit 7,d: 0=Info / 1=Set
345   FEB2 6F           		ld	l,a		;; L = requested speed index
346   FEB3 3E 17        max_index	ld	a,23		;; A = max supported speed index (always 23 since 2.0)
347   FEB5              ;max_index	ld	a,#55		;; A = max supported speed index (7,12,23)
348   FEB5 BD           		cp	l
349   FEB6 D8           		ret	c		;; Return with CY=1 if speed index overflows max speed
350   FEB7
351   FEB7
352   FEB7 01 87 FF     add_spdtab1	ld	bc,spdtab+3
353   FEBA 26 00        		ld	h,#00
354   FEBC 29           		add	hl,hl
355   FEBD 29           		add	hl,hl
356   FEBE 09           		add	hl,bc		; CY=0
357   FEBF 7E           		ld	a,(hl)		; A = HW byte for speed
358   FEC0
359   FEC0 CB 7A        		bit	7,d
360   FEC2 28 28        		jr	z,read_item
361   FEC4
362   FEC4 01 3B 14     set_speed	ld	bc,RX_SETBAUD	;now, set speed into hw
363   FEC7 ED 79        		out	(c),a
364   FEC9
365   FEC9 18 21        		jr	read_item
366   FECB
367   FECB              ;; Read speed HW code and search relevant speed in speed table
368   FECB              ;; If code not found, return BC:E = 0
369   FECB
370   FECB 11 00 FF     get_baud_rate	ld	de,#FF00
371   FECE 43           		ld	b,e
372   FECF 4B           		ld	c,e
373   FED0
374   FED0 ~            /*this part not needed anymore, since max supported speed is always 23 with new cores
