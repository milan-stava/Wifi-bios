377   FED0 ~            		sub	22
378   FED0 ~            		ret	c		;Return with CY=1 and BC:E=0 if reading speed if not supported
379   FED0 ~            */
380   FED0
381   FED0 01 3B 7C     		ld	bc,general_port	;read out currently set speed, #7C3B
382   FED3 3E 30        		ld	a,#30
383   FED5 ED 79        		out	(c),a
384   FED7 04           		inc	b
385   FED8 ED 78        		in	a,(c)
386   FEDA
387   FEDA 21 83 FF     add_spdtab2	ld	hl,spdtab-1	;find out bios index speed
388   FEDD 23           search_loop	inc	hl
389   FEDE 23           		inc	hl
390   FEDF 23           		inc	hl
391   FEE0 23           		inc	hl
392   FEE1 14           		inc	d
393   FEE2 BE           		cp	(hl)
394   FEE3 28 06        		jr	z,spd_found	;If code found, CY=0 & Z=1
395   FEE5 CB 7E        		bit	7,(hl)
396   FEE7 28 F4        		jr	z,search_loop
397   FEE9 56           		ld	d,(hl)		;Invalid index of speed D=#FF if BC:E=0
398   FEEA 37           		scf			;CY=1, Z=0
399   FEEB
400   FEEB 7A           spd_found	ld	a,d		;; A = found index of speed
401   FEEC 2B           read_item	dec	hl		;; HL = found item in baud speed table
402   FEED 5E           		ld	e,(hl)
403   FEEE 2B           		dec	hl
404   FEEF 46           		ld	b,(hl)
405   FEF0 2B           		dec	hl		;; Output:
406   FEF1 4E           		ld	c,(hl)		;;  BC:E = Baud rate (0 if speed not supported)
407   FEF2 C9           		ret			;;  D = index of speed in BC:E (#FF = not valid)
408   FEF3
409   FEF3 18 69        reloc2		jr	reloc3
410   FEF5
411   FEF5              ;; Read one byte from receive buffer
412   FEF5
413   FEF5 C5           receive_byte	push	bc
414   FEF6 D5           		push	de
415   FEF7 01 3B 13     		ld	bc,TX_CHKREADY
416   FEFA ED 78        		in	a,(c)
417   FEFC CB 47        		bit	status_data1,a		;Z = no byte to receive, NZ = byte to receive
418   FEFE 30 06        		jr	nc,rece_stat		;NC = read status only, jump to carry setting
419   FF00 28 04        		jr	z,rece_stat		;Z = no byte to receive
420   FF02
421   FF02 04           		inc	b			;B = high RX_SETBAUD
422   FF03 ED 58        		in	e,(c)			;receive byte
423   FF05 04           		inc	b			;Set NZ as flag 'received byte valid'
424   FF06
425   FF06              rece_stat	DUP	status_full+1
