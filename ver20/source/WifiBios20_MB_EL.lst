 15   0000
 16   0000              ;; ver 1.0 - 14.02.2020 - starting version
 17   0000              ;; ver 1.1 - 11.03.2020 - "turnon_wifi" routine updated, now correctly turns on the wifi module
 18   0000              ;; ver 1.2 - 30.04.2020 - New port layout and relocations of absolute addresses
 19   0000              ;; ver 1.3 - 25.05.2020 - new Wifi speeds added to "set_baud_rate"
 20   0000              ;; ver 1.4 - 03.06.2020 - new Wifi speeds added to "set_baud_rate"
 21   0000              ;;			- timeout added to "rece_block"
 22   0000              ;;			- "set_baud_rate" returns set Uart speed (as described in HW spec)
 23   0000              ;;			- "get_version_instal" returns core version
 24   0000              ;;			- "wifi_on" routine simplified
 25   0000              ;; ver 1.5 -		- release
 26   0000              ;; ver 1.6 - 18.3.2021	- "send_block- fix: now running correctly
 27   0000              ;;			- "send_block" and "rece_block" changes:
 28   0000              ;;					- key test routine removed for higher speed
 29   0000              ;;					- reg A status removed on output
 30   0000              ;;					- C/NC added on output
 31   0000              ;;			- "turnon_wifi": turns wifi on, or returns wifi state (without setting it on)
 32   0000              ;; ver 1.7 - 08.04.2021	- "get_version_install": MB03+ FW detection added-> max possible speed returned
 33   0000              ;;			- "set_baud_rate": - supported speed info returned with respect to MB03+ FW
 34   0000              ;;					   - minor bugfix
 35   0000              ;; ver 1.8 - 25.4.2021	- "set_baud_rate": - rewritten
 36   0000              ;;			- new routine GET_BAUD
 37   0000              ;;
 38   0000              ;; ver 1.9 - 9.12.2023	- added: g_zxi_0 set to external (to avoid collision with internal Wifi module in eLeMeNt ZX)
 39   0000              ;;			- added: fast clear receive buffer (new feature of MB core)
 40   0000              ;; ver 2.0 - 23.11.2025	- for coorection function of wifi bios always call "get_version_install" at the beginning
 41   0000              ;;			- fixed turnon wifi, removed device select. Only 1 bit set when turning wifi on.
 42   0000              ;;			- "get version instal" returns in E if mb was detected E= NZ=connected, E= 0=not connected, meaning el wifi is in usage.
 43   0000              ;;			- gives back speed 23 always
 44   0000              ;;			- turnon_wifi: changes just one bit, not a whole byte
 45   0000              ;;			- turnoff_wifi: new-OUT gives Z/NZ (Z= wifi cannot be turned off, NZ= wifi can be turned off)
 46   0000
 47   0000
 48   0000              vers	equ	#0200	;; Bios version: high byte = major number, low byte = minor number
 49   0000
 50   0000
 51   0000              ;; Used services
 52   0000              ;; ~~~~~~~~~~~~~
 53   0000              ;; +00 get_version_install: Get info about this bios, core version
 54   0000              ;;                          and install bios (in case of non relocatable code)
 55   0000              ;;                            INP: nothing
 56   0000              ;;                            OUT: HL = text version
 57   0000              ;;                                 BC = version number
 58   0000              ;;                                 A = max speed supported by MB03+ FW and bios (23 set as default)
 59   0000              ;;				   E = NZ=MB03+ detected, Z=MB03+ not detected
 60   0000              ;;				   LX = number of calls (bios routines)
 61   0000              ;;
 62   0000              ;; +04 turnon_wifi:         Turns Wifi module on
 63   0000              ;;				INP: NC = get status only, C = get status+ turn wifi on
 64   0000              ;;				OUT: NZ= wifi is off (in case of MB wifi), Z= wifi remains on (in case of EL wifi)
 65   0000              ;;
 66   0000              ;;
 67   0000              ;; +06 turnoff_wifi:        Turns Wifi module off (no flags)
 68   0000              ;;                            INP: nothing
 69   0000              ;;                            OUT: NZ=ok, success, Z= MB wifi not detected, el wifi in usage and cannot be turned off
 70   0000              ;;
 71   0000              ;; +08 set_baud_rate:       Get info about supported communication speeds
 72   0000              ;;                          or set selected communication speed
 73   0000              ;;                            INP: CY: 0 = get speed info only, 1 = set speed into HW
 74   0000              ;;                                 reg A = index of speed 0..23, 0=slowest, 23=fastest
 75   0000              ;;                                         Note: Index is not OUT value defined in HW !
 76   0000              ;;                            OUT: CY = 1: Error, speed not supported (returns BC:E = 0)
 77   0000              ;;                                 CY = 0: OK, BC:E = speed in Bauds, corresponding with input index in A
 78   0000              ;;
 79   0000              ;; +10 get_baud_rate:      Returns current uart speed
 80   0000              ;;                            INP: none
 81   0000              ;;                            OUT: CY: 1 = speed reading not supported by FW, BC:E = 0, A = invalid (A=#FF)
 82   0000              ;;				   CY: 0 = OK, in this case:
 83   0000              ;;				           A = index of current speed as defined in bios index speed (0-23)
 84   0000              ;;                                         BC:E = speed in Bauds,corresponding with bios index speed (0-23)
 85   0000              ;;
 86   0000              ;;                            Encoding Baud speed in registers BC:E for  set_baud_rate and get_baud_rate
 87   0000              ;;                                 Speed = BC * 10 ^ E
 88   0000              ;;                                 BC = E = 0 if speed not supported
 89   0000              ;;                                 Examle: BC=1152,E=2 ... Speed = 1152*10^2 = 115200 Bd
 90   0000              ;;
 91   0000              ;; +12 clear_receive_buffer: Resets FIFO to empty state
 92   0000              ;;                            INP: nothing
 93   0000              ;;                            OUT: nothing
 94   0000              ;;
 95   0000              ;; +16 rece_byte:           Get receive status or receive one byte
 96   0000              ;;                            INP: CY: NC = get status only,
 97   0000              ;;                                      C = get one byte from FIFO buffer
 98   0000              ;;                            OUT: Z:  Indication of emptyness of FIFO
 99   0000              ;;                                      Z = no byte to receive
100   0000              ;;                                     NZ = byte is available => reg A=byte
101   0000              ;;                                 CY: Indication of fullness of FIFO
102   0000              ;;                                     NC = buffer ok, no data lost
103   0000              ;;                                      C = overflowed and data may be lost
104   0000              ;;
105   0000              ;; +18 send_byte:           Get send status or send one byte
106   0000              ;;                            INP: CY: NC = get status only
107   0000              ;;                                      C = send one byte
108   0000              ;;                                 reg A = byte to send (if CY=1)
109   0000              ;;                            OUT: CY: NC = line free, next byte can be send
110   0000              ;;                                      C = line occupied, next byte cannot be send
111   0000              ;;
112   0000              ;; +20 rece_block:          Receive block of more bytes
113   0000              ;;                            INP: HL = address to store received data
114   0000              ;;                                 BC = number of received bytes
115   0000              ;;                                 DE = timeout (range 0- #FFFF)
116   0000              ;;                            OUT: HL = address after really read data
117   0000              ;;                                 BC = number of missing bytes (not received yet) 0 = OK
118   0000              ;;                                 C= data sent OK, NC= data not sent ok
119   0000              ;;
120   0000              ;; +22 send_block:          Send block of more bytes
121   0000              ;;                            IN: HL = address of data to send
122   0000              ;;                                BC = length  of data to send
123   0000              ;;                                DE = must be 0 (reserved for future timeout)
124   0000              ;;                           OUT: HL = address after really send data
125   0000              ;;                                BC = number of missing bytes (not send yet) 0 = OK
126   0000              ;;                                C= data sent OK, NC= data not sent ok
127   0000              ;;
128   0000              ;; Services backup all needed registers
129   0000
130   0000              ;; Hardware definitions
131   0000              ;; ~~~~~~~~~~~~~~~~~~~~
132   0000              ;;
133   0000              ;; Hardware type: ESP01 integrated in MB03
134   0000              ;;
135   0000              ;; Supported speeds as described in MB03+ HW specification:
136   0000              ;;
137   0000              ;; Out   Speed
138   0000              ;; ===   =====
139   0000              ;;   0 = 115200  (default at reset)
140   0000              ;;   1 = 57600
141   0000              ;;   2 = 38400
142   0000              ;;   3 = 31250
143   0000              ;;   4 = 19200
144   0000              ;;   5 = 9600
145   0000              ;;   6 = 4800
146   0000              ;;   7 = 2400
147   0000              ;;   8 = 230400
148   0000              ;;   9 = 460800
149   0000              ;;  10 = 576000
150   0000              ;;  11 = 921600
151   0000              ;;  12 = 1152000
152   0000              ;;  13 = 1500000
153   0000              ;;  14 = 2000000
154   0000              ;;  15 = 2304000
155   0000              ;;  16 = 3456000
156   0000              ;;  17 = 4608000
157   0000              ;;  18 = 5760000
158   0000              ;;  19 = 6912000
159   0000              ;;  20 = 8064000
160   0000              ;;  21 = 9216000
161   0000              ;;  22 = 10368000
162   0000              ;;  23 = 11520000
163   0000              ;;
164   0000              ;; Size of the read (RX) FIFO buffer is 2048 bytes.
165   0000              ;;	The Wi-Fi specification is compatible with the ZX Spectrum Next. More info on websites:
166   0000              ;;     https://specnext.dev/wiki/ESP8266-01
167   0000              ;;     https://www.specnext.com/the-next-on-the-network/
168   0000              ;;     https://www.espressif.com/sites/default/files/documentation/4a-esp8266_at_instruction_set_en.pdf
169   0000              ;; The ports are h143B = 5179 for RX and h133B = 4923 for TX.
170   0000              ;; A write to the RX port configures the UART speed:
171   0000              ;;     0 = 115200 (default at reset); 1 = 57600; 2 = 38400; 3 = 31250; 4 = 19200; 5 = 9600; 6 = 4800; 7 = 2400;
172   0000              ;;     8 = 230400;  9 = 460800; 10= 576000; 11 = 921600; 12 = 1152000; 13=1_500_000; 14=2_000_000; 15=2_304_000;
173   0000              ;;     16=3_456_000; 17=4_608_000; 18=5_760_000; 19=6_912_000; 20=8_064_000;  21=9_216_000;
174   0000              ;;     22=10_368_000; 23=11_520_000
175   0000              ;; A read from the TX port shows the status of the FIFO buffer and the TX line:
176   0000              ;;     bit 0: RX status: '0' if the buffer is empty, '1' if there is a data to be collected.
177   0000              ;;     bit 1: TX status: '1' when the TX still transmitting the last byte or '0' when the TX is idle.
178   0000              ;;     bit 2: RX status: '1' if the buffer is full,  '0' when the buffer has space to hold.
179   0000              ;;     bit 3: RX status: '0' if the buffer is almost empty, '1' when the buffer has 256 or more bytes.
180   0000              ;;     bit 4: RX status: '1' if the buffer is almost full (contains 1024 bytes or more), '0' when the buffer has space to hold.
181   0000              ;;     zxi_105 - UART speed config (port #723B)- read gets current UART speed written to port h143B, not used in 2.0. g_zxi_030 used instead
182   0000
183   0000
184   0000              status_data1	=	0	;; RX buffer contains at least 1 received byte
185   0000              status_busy	=	1
186   0000              status_full	=	2
187   0000              status_data256	=	3	;; RX buffer contains at least 256 received bytes
188   0000              status_free256	=	4
189   0000
190   0000              mb03_port	equ	#703B
191   0000              Uart_speed_port	equ	#723B
192   0000              ZXi_port6	equ	#763B
193   0000              ZXi_port7	equ	#773B
194   0000              general_port	equ	#7C3B
195   0000              element_port	equ	#783B
196   0000
197   0000
198   0000              TX_CHKREADY	equ	#133B	;; Write: bytes to send    Read: status bits
199   0000              RX_SETBAUD	equ	#143B	;; Write: set baud rate    Read: received byted
200   0000
201   0000              ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
