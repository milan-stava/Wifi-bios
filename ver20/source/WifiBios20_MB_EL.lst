305   FE86              ;; WiFi module turn ON
306   FE86
307   FE86              turnon_wifi1
308   FE86
309   FE86 CD 7B FE     turnon_wifi2	call	turn_sub
310   FE89 CB 47        		bit	0,a
311   FE8B D0           		ret	nc		;OUT=Z/NZ
312   FE8C              ;		ld	a,1
313   FE8C CB C7        		set	0,a		;set only bit 1, more correct
314   FE8E B7           		or	a
