# file opened: WifiBios19_EL.a80
  1   0000              ;; Wifi Bios for ESP 01- eLeMeNtZX
  2   0000              ;; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  3   0000              ;; Written by Busy & Hood
  4   0000              ;; Consultations & acknowldgements & ideas: LMN, Lanex, Shrek, "Uart" authors (from Specnext)
  5   0000
  6   0000              ;; differences in Wifi behaviour on EL as opposed to MB03+:
  7   0000              ;; 1) Wifi module cannot be turned ON or OFF on a port. Turnon the computer= module turnon
  8   0000              ;; 2) max communication uart speed is always 23 and not lower
  9   0000
