 42   0000
 43   0000
 44   0000              vers	equ	#0109	;; Bios version: high byte = major number, low byte = minor number
 45   0000              ;seladd	equ	0	;; Select port addresses: 0=#2X3B, 1=#7X3B
 46   0000
 47   0000              ;; Used services
 48   0000              ;; ~~~~~~~~~~~~~
 49   0000              ;; +00 get_version_install: Get info about this bios, core version
 50   0000              ;;                          and install bios (in case of non relocatable code)
 51   0000              ;;                            INP: nothing
 52   0000              ;;                            OUT: HL = text version
 53   0000              ;;                                 BC = version number
 54   0000              ;;                                 A = max speed supported by MB03+ FW and bios
 55   0000              ;;				   DE = core version read out from MB03+
 56   0000              ;;				   LX = number of calls (bios routines)
 57   0000              ;;
 58   0000              ;; +04 turnon_wifi:         Turns Wifi module on
 59   0000              ;;				INP: NC = get status only, C = get status+ turn wifi on
 60   0000              ;;				OUT: Z= wifi is off, NZ= wifi is on
 61   0000              ;;
 62   0000              ;;
 63   0000              ;; +06 turnoff_wifi:        Turns Wifi module off (no flags)
 64   0000              ;;                            INP: nothing
 65   0000              ;;                            OUT: nothing
 66   0000              ;;
 67   0000              ;; +08 set_baud_rate:       Get info about supported communication speeds
 68   0000              ;;                          or set selected communication speed
 69   0000              ;;                            INP: CY: 0 = get speed info only, 1 = set speed into HW
 70   0000              ;;                                 reg A = index of speed 0..23, 0=slowest, 23=fastest
 71   0000              ;;                                         Note: Index is not OUT value defined in HW !
 72   0000              ;;                            OUT: CY = 1: Error, speed not supported (returns BC:E = 0)
 73   0000              ;;                                 CY = 0: OK, BC:E = speed in Bauds, corresponding with input index in A
 74   0000              ;;
 75   0000              ;; +10 get_baud_rate:      Returns current uart speed
 76   0000              ;;                            INP: none
 77   0000              ;;                            OUT: CY: 1 = speed reading not supported by FW, BC:E = 0, A = invalid (A=#FF)
 78   0000              ;;				   CY: 0 = OK, in this case:
 79   0000              ;;				           A = index of current speed as defined in bios index speed (0-23)
 80   0000              ;;                                         BC:E = speed in Bauds,corresponding with bios index speed (0-23)
 81   0000              ;;
 82   0000              ;;                            Encoding Baud speed in registers BC:E for  set_baud_rate and get_baud_rate
 83   0000              ;;                                 Speed = BC * 10 ^ E
 84   0000              ;;                                 BC = E = 0 if speed not supported
 85   0000              ;;                                 Examle: BC=1152,E=2 ... Speed = 1152*10^2 = 115200 Bd
 86   0000              ;;
 87   0000              ;; +12 clear_receive_buffer: Resets FIFO to empty state
 88   0000              ;;                            INP: nothing
 89   0000              ;;                            OUT: nothing
 90   0000              ;;
 91   0000              ;; +16 rece_byte:           Get receive status or receive one byte
 92   0000              ;;                            INP: CY: NC = get status only,
 93   0000              ;;                                      C = get one byte from FIFO buffer
 94   0000              ;;                            OUT: Z:  Indication of emptyness of FIFO
 95   0000              ;;                                      Z = no byte to receive
 96   0000              ;;                                     NZ = byte is available => reg A=byte
 97   0000              ;;                                 CY: Indication of fullness of FIFO
 98   0000              ;;                                     NC = buffer ok, no data lost
 99   0000              ;;                                      C = overflowed and data may be lost
100   0000              ;;
101   0000              ;; +18 send_byte:           Get send status or send one byte
102   0000              ;;                            INP: CY: NC = get status only
103   0000              ;;                                      C = send one byte
104   0000              ;;                                 reg A = byte to send (if CY=1)
105   0000              ;;                            OUT: CY: NC = line free, next byte can be send
106   0000              ;;                                      C = line occupied, next byte cannot be send
107   0000              ;;
108   0000              ;; +20 rece_block:          Receive block of more bytes
109   0000              ;;                            INP: HL = address to store received data
110   0000              ;;                                 BC = number of received bytes
111   0000              ;;                                 DE = timeout (range 0- #FFFF)
112   0000              ;;                            OUT: HL = address after really read data
113   0000              ;;                                 BC = number of missing bytes (not received yet) 0 = OK
114   0000              ;;                                 C= data sent OK, NC= data not sent ok
115   0000              ;;
116   0000              ;; +22 send_block:          Send block of more bytes
117   0000              ;;                            IN: HL = address of data to send
118   0000              ;;                                BC = length  of data to send
119   0000              ;;                                DE = must be 0 (reserved for future timeout)
120   0000              ;;                           OUT: HL = address after really send data
121   0000              ;;                                BC = number of missing bytes (not send yet) 0 = OK
122   0000              ;;                                C= data sent OK, NC= data not sent ok
123   0000              ;;
124   0000              ;; Services backup all needed registers
125   0000
126   0000              ;; Hardware definitions
127   0000              ;; ~~~~~~~~~~~~~~~~~~~~
128   0000              ;;
129   0000              ;; Hardware type: ESP01 integrated in MB03
130   0000              ;;
131   0000              ;; Supported speeds as described in MB03+ HW specification:
132   0000              ;;
133   0000              ;; Out   Speed
134   0000              ;; ===   =====
135   0000              ;;   0 = 115200  (default at reset)
136   0000              ;;   1 = 57600
137   0000              ;;   2 = 38400
138   0000              ;;   3 = 31250
139   0000              ;;   4 = 19200
140   0000              ;;   5 = 9600
141   0000              ;;   6 = 4800
142   0000              ;;   7 = 2400
143   0000              ;;   8 = 230400
144   0000              ;;   9 = 460800
145   0000              ;;  10 = 576000
146   0000              ;;  11 = 921600
147   0000              ;;  12 = 1152000
148   0000              ;;  13 = 1500000
149   0000              ;;  14 = 2000000
150   0000              ;;  15 = 2304000
151   0000              ;;  16 = 3456000
152   0000              ;;  17 = 4608000
153   0000              ;;  18 = 5760000
154   0000              ;;  19 = 6912000
155   0000              ;;  20 = 8064000
156   0000              ;;  21 = 9216000
157   0000              ;;  22 = 10368000
158   0000              ;;  23 = 11520000
159   0000              ;;
160   0000              ;; Size of the read (RX) FIFO buffer is 2048 bytes.
161   0000              ;;	The Wi-Fi specification is compatible with the ZX Spectrum Next. More info on websites:
162   0000              ;;     https://specnext.dev/wiki/ESP8266-01
163   0000              ;;     https://www.specnext.com/the-next-on-the-network/
164   0000              ;;     https://www.espressif.com/sites/default/files/documentation/4a-esp8266_at_instruction_set_en.pdf
165   0000              ;; The ports are h143B = 5179 for RX and h133B = 4923 for TX.
166   0000              ;; A write to the RX port configures the UART speed:
167   0000              ;;     0 = 115200 (default at reset); 1 = 57600; 2 = 38400; 3 = 31250; 4 = 19200; 5 = 9600; 6 = 4800; 7 = 2400;
168   0000              ;;     8 = 230400;  9 = 460800; 10= 576000; 11 = 921600; 12 = 1152000; 13=1_500_000; 14=2_000_000; 15=2_304_000;
169   0000              ;;     16=3_456_000; 17=4_608_000; 18=5_760_000; 19=6_912_000; 20=8_064_000;  21=9_216_000;
170   0000              ;;     22=10_368_000; 23=11_520_000
171   0000              ;; A read from the TX port shows the status of the FIFO buffer and the TX line:
172   0000              ;;     bit 0: RX status: '0' if the buffer is empty, '1' if there is a data to be collected.
173   0000              ;;     bit 1: TX status: '1' when the TX still transmitting the last byte or '0' when the TX is idle.
174   0000              ;;     bit 2: RX status: '1' if the buffer is full,  '0' when the buffer has space to hold.
175   0000              ;;     bit 3: RX status: '0' if the buffer is almost empty, '1' when the buffer has 256 or more bytes.
176   0000              ;;     bit 4: RX status: '1' if the buffer is almost full (contains 1024 bytes or more), '0' when the buffer has space to hold.
177   0000              ;;     zxi_105 - UART speed config (port #723B)- read gets current UART speed written to port h143B
178   0000
179   0000
180   0000              status_data1	=	0	;; RX buffer contains at least 1 received byte
181   0000              status_busy	=	1
182   0000              status_full	=	2
183   0000              status_data256	=	3	;; RX buffer contains at least 256 received bytes
184   0000              status_free256	=	4
185   0000
186   0000              ;		IF seladd=0
187   0000              ;portselect	equ	#203B
188   0000              ;ZXi_port6	equ	#263B
189   0000              ;		ENDIF
190   0000
191   0000              ;		IF seladd=1
192   0000              portselect	equ	#703B
193   0000              general_port	equ	#7C3B
194   0000              element_port	equ	#783B
195   0000              ;ZXi_port6	equ	#763B
196   0000              ;		ENDIF
197   0000
198   0000              TX_CHKREADY	equ	#133B	;; Write: bytes to send    Read: status bits
199   0000              RX_SETBAUD	equ	#143B	;; Write: set baud rate    Read: received byted
200   0000
