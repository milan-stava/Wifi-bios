334   FEA5              ;; Set/Get baud rate
335   FEA5
336   FEA5 1E 00        set_baud_rate	ld	e,#00		;; We have 24 speeds on ESP01 in MB03 so far
337   FEA7 43           		ld	b,e		;; in case of error speed 0 will be returned
338   FEA8 4B           		ld	c,e
339   FEA9 CB 1A        		rr	d		;; Bit 7,d: 0=Info / 1=Set
340   FEAB 6F           		ld	l,a		;; L = requested speed index
341   FEAC 3E 55        max_index	ld	a,#55		;; A = max supported speed index (7,12,23)
342   FEAE BD           		cp	l
343   FEAF D8           		ret	c		;; Return with CY=1 if speed index overflows max speed
344   FEB0
345   FEB0 01 87 FF     add_spdtab1	ld	bc,spdtab+3
346   FEB3 26 00        		ld	h,#00
347   FEB5 29           		add	hl,hl
348   FEB6 29           		add	hl,hl
349   FEB7 09           		add	hl,bc		; CY=0
350   FEB8 7E           		ld	a,(hl)		; A = HW byte for speed
351   FEB9
352   FEB9 CB 7A        		bit	7,d
353   FEBB 28 2F        		jr	z,read_item
354   FEBD
355   FEBD 01 3B 14     set_speed	ld	bc,RX_SETBAUD	;now, set speed into hw
356   FEC0 ED 79        		out	(c),a
357   FEC2
358   FEC2 18 28        		jr	read_item
359   FEC4
360   FEC4              ;; Read speed HW code and search relevant speed in speed table
361   FEC4              ;; If code not found, return BC:E = 0
362   FEC4
363   FEC4 11 00 FF     get_baud_rate	ld	de,#FF00
364   FEC7 43           		ld	b,e
365   FEC8 4B           		ld	c,e
366   FEC9 3A AD FE     get_max_idx	ld	a,(max_index+1)	;A= max speed allowed by MB03+ FW (7, 12 or 23)
367   FECC D6 16        		sub	22
