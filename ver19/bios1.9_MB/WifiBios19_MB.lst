315   FE8D              ;; Clear receive buffer
316   FE8D
317   FE8D 01 3B 7C     clear_loop2	ld	bc,general_range	;fast clear receive buffer
318   FE90 3E 30        		ld	a,#30
319   FE92 ED 79        		out	(c),a
320   FE94 3E 01        		ld	a,1
321   FE96 04           		inc	b
322   FE97 ED 79        		out	(c),a
323   FE99
324   FE99 3E 13        clear_loop1	ld	a,high TX_CHKREADY
325   FE9B DB 3B        		in	a,(low TX_CHKREADY)
326   FE9D 0F           		rrca
327   FE9E D0           		ret	nc
328   FE9F 3E 14        		ld	a,high RX_SETBAUD
329   FEA1 DB 3B        		in	a,(low RX_SETBAUD)
