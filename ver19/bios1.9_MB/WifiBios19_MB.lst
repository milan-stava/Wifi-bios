378   FEDD 23           search_loop	inc	hl
379   FEDE 23           		inc	hl
380   FEDF 23           		inc	hl
381   FEE0 23           		inc	hl
382   FEE1 14           		inc	d
383   FEE2 BE           		cp	(hl)
384   FEE3 28 06        		jr	z,spd_found	;If code found, CY=0 & Z=1
385   FEE5 CB 7E        		bit	7,(hl)
386   FEE7 28 F4        		jr	z,search_loop
387   FEE9 56           		ld	d,(hl)		;Invalid index of speed D=#FF if BC:E=0
388   FEEA 37           		scf			;CY=1, Z=0
389   FEEB
390   FEEB 7A           spd_found	ld	a,d		;; A = found index of speed
391   FEEC 2B           read_item	dec	hl		;; HL = found item in baud speed table
392   FEED 5E           		ld	e,(hl)
393   FEEE 2B           		dec	hl
394   FEEF 46           		ld	b,(hl)
395   FEF0 2B           		dec	hl		;; Output:
396   FEF1 4E           		ld	c,(hl)		;;  BC:E = Baud rate (0 if speed not supported)
397   FEF2 C9           		ret			;;  D = index of speed in BC:E (#FF = not valid)
