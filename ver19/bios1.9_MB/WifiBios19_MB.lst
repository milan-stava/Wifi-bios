296   FE75 01 3B 7C     turnon_wifi1	ld	bc,general_range	;set general range to external
297   FE78              ;		xor	a			;before turning wifi module on.XOR A cannot be used, it spols carry
298   FE78 3E 00        		ld	a,0
299   FE7A ED 79        		out	(c),a
300   FE7C 04           		inc	b
301   FE7D              ;		in	a,(c)
302   FE7D              ;		res	0,a
303   FE7D ED 79        		out	(c),a			;value =external device
304   FE7F
305   FE7F CD 6A FE     turnon_wifi2	call	turn_sub
306   FE82 CB 47        		bit	0,a
307   FE84 D0           		ret	nc		;OUT=Z/NZ
308   FE85 3E 01        		ld	a,1
309   FE87 B7           		or	a
