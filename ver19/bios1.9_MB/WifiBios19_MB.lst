232   FE1B 18 6E        install_getver	jr	reloc1
233   FE1D
234   FE1D 01 3B 70     		ld	bc,portselect
235   FE20              ;		ld	b,high portselect
236   FE20 3E FF        		ld	a,#FF
237   FE22 ED 79        		out	(c),a
238   FE24 06 76        		ld	b,high ZXi_port6
239   FE26 21 F3 FF     add_biosid	ld	hl,reloc		;read core version to "reloc" address
240   FE29 E5           		push	hl
241   FE2A ED 78        biosid_loop	in	a,(c)
242   FE2C 77           		ld	(hl),a
243   FE2D 23           		inc	hl
244   FE2E 05           		dec	b
245   FE2F 78           		ld	a,b
246   FE30 FE 70        		cp	high portselect
247   FE32 20 F6        		jr	nz,biosid_loop
248   FE34
249   FE34 E1           		pop	hl
250   FE35 E5           		push	hl
251   FE36 16 07        		ld	d,7			;now set speed and retry answer from AT command
252   FE38 7E           		ld	a,(hl)			;HL=core version found
253   FE39 FE 14        		cp	20
254   FE3B 38 12        		jr	c,got_max_speed		;found core <2019xxxxx, max speed=7= 115_200 Bd
255   FE3D 28 04        		jr	z,sc1
256   FE3F 16 17        		ld	d,23
257   FE41 30 0C        		jr	nc,got_max_speed	;NC=found core>202006xx, max speed=23= 11_500_200 Bd
258   FE43 23           sc1		inc	hl
259   FE44 7E           		ld	a,(hl)
260   FE45 FE 05        		cp	5
261   FE47 38 06        		jr	c,got_max_speed		;found core 202004xx, max speed=7= 115_200 Bd
262   FE49 16 0C        		ld	d,12
263   FE4B 28 02        		jr	z,got_max_speed		;Z=found core 202005xx, max speed=12= 1_152_000 Bd
264   FE4D 16 17        		ld	d,23			;found core >202006xx, max speed=23= 11_500_200 Bd
265   FE4F 7A           got_max_speed	ld	a,d			;d=7 or 12 or 23
266   FE50 32 AD FE     set_max_idx	ld	(max_index+1),a
267   FE53
268   FE53 D1           biosid_end	pop	de
269   FE54 21 E8 FF     		ld	hl,bios_id
270   FE57 DD 2E 0C     		ld	lx,num_of_calls
