# file opened: WifiBios19_MB.a80
  1   0000              ;; Wifi Bios for ESP 01- MB03
  2   0000              ;; ~~~~~~~~~~~~~~~~~~~~~~~~~~
  3   0000              ;; Written by Busy & Hood
  4   0000              ;; Consultations & acknowldgements & ideas: LMN, Lanex, Shrek, "Uart" authors (from Specnext)
  5   0000
  6   0000              ;; ver 1.0 - 14.02.2020 - starting version
  7   0000              ;; ver 1.1 - 11.03.2020 - "turnon_wifi" routine updated, now correctly turns on the wifi module
  8   0000              ;; ver 1.2 - 30.04.2020 - New port layout and relocations of absolute addresses
  9   0000              ;; ver 1.3 - 25.05.2020 - new Wifi speeds added to "set_baud_rate"
 10   0000              ;; ver 1.4 - 03.06.2020 - new Wifi speeds added to "set_baud_rate"
 11   0000              ;;			- timeout added to "rece_block"
 12   0000              ;;			- "set_baud_rate" returns set Uart speed (as described in HW spec)
 13   0000              ;;			- "get_version_instal" returns core version
 14   0000              ;;			- "wifi_on" routine simplified
 15   0000              ;; ver 1.5 -		- release
 16   0000              ;; ver 1.6 - 18.3.2021	- "send_block- fix: now running correctly
 17   0000              ;;			- "send_block" and "rece_block" changes:
 18   0000              ;;					- key test routine removed for higher speed
 19   0000              ;;					- reg A status removed on output
 20   0000              ;;					- C/NC added on output
 21   0000              ;;			- "turnon_wifi": turns wifi on, or returns wifi state (without setting it on)
 22   0000              ;; ver 1.7 - 08.04.2021	- "get_version_install": MB03+ FW detection added-> max possible speed returned
 23   0000              ;;			- "set_baud_rate": - supported speed info returned with respect to MB03+ FW
 24   0000              ;;					   - minor bugfix
 25   0000              ;; ver 1.8 - 25.4.2021	- "set_baud_rate": - rewritten
 26   0000              ;;			- new routine GET_BAUD
 27   0000              ;;
 28   0000              ;; ver 1.9 - 9.12.2023	- added: g_zxi_0 set to external (to avoid collision with internal Wifi module in eLeMeNt ZX)
 29   0000              ;;			- added: fast clear receive buffer (new feature of MB core)
 30   0000
 31   0000
 32   0000
 33   0000              vers	equ	#0109	;; Bios version: high byte = major number, low byte = minor number
 34   0000              seladd	equ	1	;; Select port addresses: 0=#2X3B, 1=#7X3B
 35   0000
 36   0000              ;; Used services
 37   0000              ;; ~~~~~~~~~~~~~
 38   0000              ;; +00 get_version_install: Get info about this bios, core version
 39   0000              ;;                          and install bios (in case of non relocatable code)
 40   0000              ;;                            INP: nothing
 41   0000              ;;                            OUT: HL = text version
 42   0000              ;;                                 BC = version number
 43   0000              ;;                                 A = max speed supported by MB03+ FW and bios
 44   0000              ;;				   DE = core version read out from MB03+
 45   0000              ;;				   LX = number of calls (bios routines)
 46   0000              ;;
 47   0000              ;; +04 turnon_wifi:         Turns Wifi module on
 48   0000              ;;				INP: NC = get status only, C = get status+ turn wifi on
 49   0000              ;;				OUT: Z= wifi is off, NZ= wifi is on
 50   0000              ;;
 51   0000              ;;
 52   0000              ;; +06 turnoff_wifi:        Turns Wifi module off (no flags)
 53   0000              ;;                            INP: nothing
 54   0000              ;;                            OUT: nothing
 55   0000              ;;
 56   0000              ;; +08 set_baud_rate:       Get info about supported communication speeds
 57   0000              ;;                          or set selected communication speed
 58   0000              ;;                            INP: CY: 0 = get speed info only, 1 = set speed into HW
 59   0000              ;;                                 reg A = index of speed 0..23, 0=slowest, 23=fastest
 60   0000              ;;                                         Note: Index is not OUT value defined in HW !
 61   0000              ;;                            OUT: CY = 1: Error, speed not supported (returns BC:E = 0)
 62   0000              ;;                                 CY = 0: OK, BC:E = speed in Bauds, corresponding with input index in A
 63   0000              ;;
 64   0000              ;; +10 get_baud_rate:      Returns current uart speed
 65   0000              ;;                            INP: none
 66   0000              ;;                            OUT: CY: 1 = speed reading not supported by FW, BC:E = 0, A = invalid (A=#FF)
 67   0000              ;;				   CY: 0 = OK, in this case:
 68   0000              ;;				           A = index of current speed as defined in bios index speed (0-23)
 69   0000              ;;                                         BC:E = speed in Bauds,corresponding with bios index speed (0-23)
 70   0000              ;;
 71   0000              ;;                            Encoding Baud speed in registers BC:E for  set_baud_rate and get_baud_rate
 72   0000              ;;                                 Speed = BC * 10 ^ E
 73   0000              ;;                                 BC = E = 0 if speed not supported
 74   0000              ;;                                 Examle: BC=1152,E=2 ... Speed = 1152*10^2 = 115200 Bd
 75   0000              ;;
 76   0000              ;; +12 clear_receive_buffer: Resets FIFO to empty state
 77   0000              ;;                            INP: nothing
 78   0000              ;;                            OUT: nothing
 79   0000              ;;
 80   0000              ;; +16 rece_byte:           Get receive status or receive one byte
 81   0000              ;;                            INP: CY: NC = get status only,
 82   0000              ;;                                      C = get one byte from FIFO buffer
 83   0000              ;;                            OUT: Z:  Indication of emptyness of FIFO
 84   0000              ;;                                      Z = no byte to receive
 85   0000              ;;                                     NZ = byte is available => reg A=byte
 86   0000              ;;                                 CY: Indication of fullness of FIFO
 87   0000              ;;                                     NC = buffer ok, no data lost
 88   0000              ;;                                      C = overflowed and data may be lost
 89   0000              ;;
 90   0000              ;; +18 send_byte:           Get send status or send one byte
 91   0000              ;;                            INP: CY: NC = get status only
 92   0000              ;;                                      C = send one byte
 93   0000              ;;                                 reg A = byte to send (if CY=1)
 94   0000              ;;                            OUT: CY: NC = line free, next byte can be send
 95   0000              ;;                                      C = line occupied, next byte cannot be send
 96   0000              ;;
 97   0000              ;; +20 rece_block:          Receive block of more bytes
 98   0000              ;;                            INP: HL = address to store received data
 99   0000              ;;                                 BC = number of received bytes
100   0000              ;;                                 DE = timeout (range 0- #FFFF)
101   0000              ;;                            OUT: HL = address after really read data
102   0000              ;;                                 BC = number of missing bytes (not received yet) 0 = OK
103   0000              ;;                                 C= data sent OK, NC= data not sent ok
104   0000              ;;
105   0000              ;; +22 send_block:          Send block of more bytes
106   0000              ;;                            IN: HL = address of data to send
107   0000              ;;                                BC = length  of data to send
108   0000              ;;                                DE = must be 0 (reserved for future timeout)
109   0000              ;;                           OUT: HL = address after really send data
110   0000              ;;                                BC = number of missing bytes (not send yet) 0 = OK
111   0000              ;;                                C= data sent OK, NC= data not sent ok
112   0000              ;;
113   0000              ;; Services backup all needed registers
114   0000
115   0000              ;; Hardware definitions
116   0000              ;; ~~~~~~~~~~~~~~~~~~~~
117   0000              ;;
118   0000              ;; Hardware type: ESP01 integrated in MB03
119   0000              ;;
120   0000              ;; Supported speeds as described in MB03+ HW specification:
121   0000              ;;
122   0000              ;; Out   Speed
123   0000              ;; ===   =====
124   0000              ;;   0 = 115200  (default at reset)
125   0000              ;;   1 = 57600
126   0000              ;;   2 = 38400
127   0000              ;;   3 = 31250
128   0000              ;;   4 = 19200
129   0000              ;;   5 = 9600
130   0000              ;;   6 = 4800
131   0000              ;;   7 = 2400
132   0000              ;;   8 = 230400
133   0000              ;;   9 = 460800
134   0000              ;;  10 = 576000
135   0000              ;;  11 = 921600
136   0000              ;;  12 = 1152000
137   0000              ;;  13 = 1500000
138   0000              ;;  14 = 2000000
139   0000              ;;  15 = 2304000
140   0000              ;;  16 = 3456000
141   0000              ;;  17 = 4608000
142   0000              ;;  18 = 5760000
143   0000              ;;  19 = 6912000
144   0000              ;;  20 = 8064000
145   0000              ;;  21 = 9216000
146   0000              ;;  22 = 10368000
147   0000              ;;  23 = 11520000
148   0000              ;;
149   0000              ;; Size of the read (RX) FIFO buffer is 2048 bytes.
150   0000              ;;	The Wi-Fi specification is compatible with the ZX Spectrum Next. More info on websites:
151   0000              ;;     https://specnext.dev/wiki/ESP8266-01
152   0000              ;;     https://www.specnext.com/the-next-on-the-network/
153   0000              ;;     https://www.espressif.com/sites/default/files/documentation/4a-esp8266_at_instruction_set_en.pdf
154   0000              ;; The ports are h143B = 5179 for RX and h133B = 4923 for TX.
155   0000              ;; A write to the RX port configures the UART speed:
156   0000              ;;     0 = 115200 (default at reset); 1 = 57600; 2 = 38400; 3 = 31250; 4 = 19200; 5 = 9600; 6 = 4800; 7 = 2400;
157   0000              ;;     8 = 230400;  9 = 460800; 10= 576000; 11 = 921600; 12 = 1152000; 13=1_500_000; 14=2_000_000; 15=2_304_000;
158   0000              ;;     16=3_456_000; 17=4_608_000; 18=5_760_000; 19=6_912_000; 20=8_064_000;  21=9_216_000;
159   0000              ;;     22=10_368_000; 23=11_520_000
160   0000              ;; A read from the TX port shows the status of the FIFO buffer and the TX line:
161   0000              ;;     bit 0: RX status: '0' if the buffer is empty, '1' if there is a data to be collected.
162   0000              ;;     bit 1: TX status: '1' when the TX still transmitting the last byte or '0' when the TX is idle.
163   0000              ;;     bit 2: RX status: '1' if the buffer is full,  '0' when the buffer has space to hold.
164   0000              ;;     bit 3: RX status: '0' if the buffer is almost empty, '1' when the buffer has 256 or more bytes.
165   0000              ;;     bit 4: RX status: '1' if the buffer is almost full (contains 1024 bytes or more), '0' when the buffer has space to hold.
166   0000              ;;     zxi_105 - UART speed config (port #723B)- read gets current UART speed written to port h143B
167   0000
168   0000
169   0000              status_data1	=	0	;; RX buffer contains at least 1 received byte
170   0000              status_busy	=	1
171   0000              status_full	=	2
172   0000              status_data256	=	3	;; RX buffer contains at least 256 received bytes
173   0000              status_free256	=	4
174   0000
175   0000              		IF seladd=0
176   0000 ~            portselect	equ	#203B
177   0000 ~            Uart_speed_port	equ	#223B
178   0000 ~            ZXi_port6	equ	#263B
179   0000 ~            general_range	equ	#2C3B
180   0000              		ENDIF
181   0000
182   0000              		IF seladd=1
183   0000              portselect	equ	#703B
184   0000              Uart_speed_port	equ	#723B
185   0000              ZXi_port6	equ	#763B
186   0000              general_range	equ	#7C3B
187   0000              		ENDIF
188   0000
189   0000              TX_CHKREADY	equ	#133B	;; Write: bytes to send    Read: status bits
190   0000              RX_SETBAUD	equ	#143B	;; Write: set baud rate    Read: received byted
191   0000
