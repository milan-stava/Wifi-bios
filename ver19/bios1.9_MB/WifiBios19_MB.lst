399   FEF3 18 69        reloc2		jr	reloc3
400   FEF5
401   FEF5              ;; Read one byte from receive buffer
402   FEF5
403   FEF5 C5           receive_byte	push	bc
404   FEF6 D5           		push	de
405   FEF7 01 3B 13     		ld	bc,TX_CHKREADY
406   FEFA ED 78        		in	a,(c)
407   FEFC CB 47        		bit	status_data1,a		;Z = no byte to receive, NZ = byte to receive
408   FEFE 30 06        		jr	nc,rece_stat		;NC = read status only, jump to carry setting
409   FF00 28 04        		jr	z,rece_stat		;Z = no byte to receive
410   FF02
411   FF02 04           		inc	b			;B = high RX_SETBAUD
412   FF03 ED 58        		in	e,(c)			;receive byte
413   FF05 04           		inc	b			;Set NZ as flag 'received byte valid'
414   FF06
415   FF06              rece_stat	DUP	status_full+1
416   FF06 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
416   FF07 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
416   FF08 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
417   FF09              		EDUP
418   FF09 18 13        		jr	ld_pop_ret		;received byte to reg. A (even if C, this is ok for some apps)
419   FF0B
420   FF0B
421   FF0B
422   FF0B
423   FF0B              ;; Transmit one byte
424   FF0B
425   FF0B C5           sending_byte	push	bc
426   FF0C D5           		push	de
427   FF0D 5F           		ld	e,a		;E= byte to send
428   FF0E 01 3B 13     		ld	bc,TX_CHKREADY
429   FF11 ED 78        		in	a,(c)		;does not change carry
430   FF13 30 07        		jr	nc,send_status
