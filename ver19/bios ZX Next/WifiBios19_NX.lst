 33   0000              ;; ver 1.0 - 14.02.2020 - starting version
 34   0000              ;; ver 1.1 - 11.03.2020 - "turnon_wifi" routine updated, now correctly turns on the wifi module
 35   0000              ;; ver 1.2 - 30.04.2020 - New port layout and relocations of absolute addresses
 36   0000              ;; ver 1.3 - 25.05.2020 - new Wifi speeds added to "set_baud_rate"
 37   0000              ;; ver 1.4 - 03.06.2020 - new Wifi speeds added to "set_baud_rate"
 38   0000              ;;			- timeout added to "rece_block"
 39   0000              ;;			- "set_baud_rate" returns set Uart speed (as described in HW spec)
 40   0000              ;;			- "get_version_instal" returns core version
 41   0000              ;;			- "wifi_on" routine simplified
 42   0000              ;; ver 1.5 -		- release
 43   0000              ;; ver 1.6 - 18.3.2021	- "send_block- fix: now running correctly
 44   0000              ;;			- "send_block" and "rece_block" changes:
 45   0000              ;;					- key test routine removed for higher speed
 46   0000              ;;					- reg A status removed on output
 47   0000              ;;					- C/NC added on output
 48   0000              ;;			- "turnon_wifi": turns wifi on, or returns wifi state (without setting it on)
 49   0000              ;; ver 1.7 - 08.04.2021	- "get_version_install": MB03+ FW detection added-> max possible speed returned
 50   0000              ;;			- "set_baud_rate": - supported speed info returned with respect to MB03+ FW
 51   0000              ;;					   - minor bugfix
 52   0000              ;; ver 1.8 - 25.4.2021	- "set_baud_rate": - rewritten
 53   0000              ;;			- new routine GET_BAUD
 54   0000              ;; ver 1.9 - 9.12.2023	- added: g_zxi_0 set to external (to avoid collision with internal Wifi module in eLeMeNt ZX)
 55   0000              ;;			- added: fast clear receive buffer (new feature of MB core)
 56   0000              ;;			- added: turn off Wifi module in MB03+
