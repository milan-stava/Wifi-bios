 59   0000
 60   0000              vers	equ	#0109	;; Bios version: high byte = major number, low byte = minor number
 61   0000              ;seladd	equ	0	;; Select port addresses: 0=#2X3B, 1=#7X3B
 62   0000
 63   0000              ;; Used services
 64   0000              ;; ~~~~~~~~~~~~~
 65   0000              ;; +00 get_version_install: Get info about this bios, (core version not implemented)
 66   0000              ;;                          and install bios (in case of non relocatable code)
 67   0000              ;;                            INP: nothing
 68   0000              ;;                            OUT: HL = text version
 69   0000              ;;                                 BC = version number
 70   0000              ;;                                 A = max speed supported by ZX Next (14 by default)
 71   0000              ;;				   DE = core version read out from ZX Next (not implemented)
 72   0000              ;;				   LX = number of calls (bios routines)
 73   0000              ;;
 74   0000              ;; +02 reset_wifi:	Resets ESP module.
 75   0000              ;;				INP: nothing
 76   0000              ;;				OUT: nothing
 77   0000              ;;
 78   0000              ;; +04 turnon_wifi:         Turns Wifi module on
 79   0000              ;;				INP: NC = get status only, C = get status+ turn wifi on
 80   0000              ;;				OUT: Z= wifi is off, NZ= wifi is on
 81   0000              ;;
 82   0000              ;;
 83   0000              ;; +06 turnoff_wifi:        Turns Wifi module off (no flags)
 84   0000              ;;                            INP: nothing
 85   0000              ;;                            OUT: nothing
 86   0000              ;;
 87   0000              ;; +08 set_baud_rate:       Get info about supported communication speeds
 88   0000              ;;                          or set selected communication speed
 89   0000              ;;                            INP: CY: 0 = get speed info only, 1 = set speed into HW
 90   0000              ;;                                 reg A = index of speed 0..14, 0=slowest, 14=fastest
 91   0000              ;;                                         Note: Index is not OUT value defined in HW !
 92   0000              ;;                            OUT: CY = 1: Error, speed not supported (returns BC:E = 0)
 93   0000              ;;                                 CY = 0: OK, BC:E = speed in Bauds, corresponding with input index in A
 94   0000              ;;
 95   0000              ;; +10 get_baud_rate:      Returns current uart speed
 96   0000              ;;                            INP: none
 97   0000              ;;                            OUT: CY: 1 = speed reading not supported by FW, BC:E = 0, A = invalid (A=#FF)
 98   0000              ;;				   CY: 0 = OK, in this case:
 99   0000              ;;				           A = index of current speed as defined in bios index speed (0-23)
100   0000              ;;                                         BC:E = speed in Bauds,corresponding with bios index speed (0-23)
101   0000              ;;
102   0000              ;;                            Encoding Baud speed in registers BC:E for  set_baud_rate and get_baud_rate
103   0000              ;;                                 Speed = BC * 10 ^ E
104   0000              ;;                                 BC = E = 0 if speed not supported
105   0000              ;;                                 Examle: BC=1152,E=2 ... Speed = 1152*10^2 = 115200 Bd
106   0000              ;;
107   0000              ;; +12 clear_receive_buffer: Resets FIFO to empty state
108   0000              ;;                            INP: nothing
109   0000              ;;                            OUT: nothing
110   0000              ;;
111   0000              ;; +16 rece_byte:           Get receive status or receive one byte
112   0000              ;;                            INP: CY: NC = get status only,
113   0000              ;;                                      C = get one byte from FIFO buffer
114   0000              ;;                            OUT: Z:  Indication of emptyness of FIFO
115   0000              ;;                                      Z = no byte to receive
116   0000              ;;                                     NZ = byte is available => reg A=byte
117   0000              ;;                                 CY: Indication of fullness of FIFO
118   0000              ;;                                     NC = buffer ok, no data lost
119   0000              ;;                                      C = overflowed and data may be lost
120   0000              ;;
121   0000              ;; +18 send_byte:           Get send status or send one byte
122   0000              ;;                            INP: CY: NC = get status only
123   0000              ;;                                      C = send one byte
124   0000              ;;                                 reg A = byte to send (if CY=1)
125   0000              ;;                            OUT: CY: NC = line free, next byte can be send
126   0000              ;;                                      C = line occupied, next byte cannot be send
127   0000              ;;
128   0000              ;; +20 rece_block:          Receive block of more bytes
129   0000              ;;                            INP: HL = address to store received data
130   0000              ;;                                 BC = number of received bytes
131   0000              ;;                                 DE = timeout (range 0- #FFFF)
132   0000              ;;                            OUT: HL = address after really read data
133   0000              ;;                                 BC = number of missing bytes (not received yet) 0 = OK
134   0000              ;;                                 C= data sent OK, NC= data not sent ok
135   0000              ;;
136   0000              ;; +22 send_block:          Send block of more bytes
137   0000              ;;                            IN: HL = address of data to send
138   0000              ;;                                BC = length  of data to send
139   0000              ;;                                DE = must be 0 (reserved for future timeout)
140   0000              ;;                           OUT: HL = address after really send data
141   0000              ;;                                BC = number of missing bytes (not send yet) 0 = OK
142   0000              ;;                                C= data sent OK, NC= data not sent ok
143   0000              ;;
144   0000              ;; Services backup all needed registers
145   0000
146   0000              ;; Hardware definitions
147   0000              ;; ~~~~~~~~~~~~~~~~~~~~
148   0000              ;;
149   0000              ;; Hardware type: ESP01 integrated in MB03
150   0000              ;;
151   0000              ;; Supported speeds as described in MB03+ HW specification:
152   0000              ;;
153   0000              ;; Out   Speed
154   0000              ;; ===   =====
155   0000              ;;   0 = 115200  (default at reset)
156   0000              ;;   1 = 57600
157   0000              ;;   2 = 38400
158   0000              ;;   3 = 31250
159   0000              ;;   4 = 19200
160   0000              ;;   5 = 9600
161   0000              ;;   6 = 4800
162   0000              ;;   7 = 2400
163   0000              ;;   8 = 230400
164   0000              ;;   9 = 460800
165   0000              ;;  10 = 576000
166   0000              ;;  11 = 921600
167   0000              ;;  12 = 1152000
168   0000              ;;  13 = 1500000
169   0000              ;;  14 = 2000000
170   0000              ;;
171   0000              ;; Size of the read (RX) FIFO buffer is 512 bytes.
172   0000              ;;	The Wi-Fi specification is compatible with the ZX Spectrum Next. More info on websites:
173   0000              ;;     https://specnext.dev/wiki/ESP8266-01
174   0000              ;;     https://www.specnext.com/the-next-on-the-network/
175   0000              ;;     https://www.espressif.com/sites/default/files/documentation/4a-esp8266_at_instruction_set_en.pdf
176   0000              ;; The ports are h143B = 5179 for RX and h133B = 4923 for TX.
177   0000              ;; A write to the RX port configures the UART speed:
178   0000              ;;     0 = 115200 (default at reset); 1 = 57600; 2 = 38400; 3 = 31250; 4 = 19200; 5 = 9600; 6 = 4800; 7 = 2400;
179   0000              ;;     8 = 230400;  9 = 460800; 10= 576000; 11 = 921600; 12 = 1152000; 13=1_500_000; 14=2_000_000; 15=2_304_000;
180   0000              ;;     16=3_456_000; 17=4_608_000; 18=5_760_000; 19=6_912_000; 20=8_064_000;  21=9_216_000;
181   0000              ;;     22=10_368_000; 23=11_520_000
182   0000              ;; A read from the TX port shows the status of the FIFO buffer and the TX line:
183   0000              ;;     bit 0: RX status: '0' if the buffer is empty, '1' if there is a data to be collected.
184   0000              ;;     bit 1: TX status: '1' when the TX still transmitting the last byte or '0' when the TX is idle.
185   0000              ;;     bit 2: RX status: '1' if the buffer is full,  '0' when the buffer has space to hold.
186   0000              ;;     bit 3: RX status: '0' if the buffer is almost empty, '1' when the buffer has 256 or more bytes.
187   0000              ;;     bit 4: RX status: '1' if the buffer is almost full (contains 1024 bytes or more), '0' when the buffer has space to hold.
188   0000              ;;     zxi_105 - UART speed config (port #723B)- read gets current UART speed written to port h143B
189   0000
190   0000
191   0000              status_data1	=	0	;; RX buffer contains at least 1 received byte
192   0000              status_busy	=	1
193   0000              status_full	=	2
194   0000              status_data256	=	3	;; RX buffer contains at least 256 received bytes
195   0000              status_free256	=	4
196   0000
197   0000              ;		IF seladd=0
198   0000              ;portselect	equ	#203B
199   0000              ;ZXi_port6	equ	#263B
200   0000              ;		ENDIF
201   0000
202   0000              ;		IF seladd=1
203   0000              ;portselect	equ	#703B
204   0000              ;general_port	equ	#7C3B
205   0000              element_port	equ	#783B
206   0000              ;ZXi_port6	equ	#763B
207   0000              ;		ENDIF
208   0000
209   0000              TX_CHKREADY	equ	#133B	;; Write: bytes to send    Read: status bits
210   0000              RX_SETBAUD	equ	#143B	;; Write: set baud rate    Read: received byted
211   0000              NextREG02	equ	2
212   0000
