377   FE38              ;; Read one byte from receive buffer
378   FE38
379   FE38 C5           receive_byte	push	bc
380   FE39 D5           		push	de
381   FE3A 01 3B 13     		ld	bc,TX_CHKREADY
382   FE3D ED 78        		in	a,(c)
383   FE3F CB 47        		bit	status_data1,a		;Z = no byte to receive, NZ = byte to receive
384   FE41 30 06        		jr	nc,rece_stat		;NC = read status only, jump to carry setting
385   FE43 28 04        		jr	z,rece_stat		;Z = no byte to receive
386   FE45
387   FE45 04           		inc	b			;B = high RX_SETBAUD
388   FE46 ED 58        		in	e,(c)			;receive byte
389   FE48 04           		inc	b			;Set NZ as flag 'received byte valid'
390   FE49
391   FE49              rece_stat	DUP	status_full+1
392   FE49 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
392   FE4A 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
392   FE4B 0F          >		rrca				;Set CY according to fullness of buffer. Zero is not changed.
393   FE4C              		EDUP
394   FE4C 18 13        		jr	ld_pop_ret		;received byte to reg. A (even if C, this is ok for some apps)
395   FE4E
396   FE4E
397   FE4E
398   FE4E
399   FE4E              ;; Transmit one byte
400   FE4E
401   FE4E C5           sending_byte	push	bc
402   FE4F D5           		push	de
403   FE50 5F           		ld	e,a		;E= byte to send
404   FE51 01 3B 13     		ld	bc,TX_CHKREADY
405   FE54 ED 78        		in	a,(c)		;does not change carry
406   FE56 30 07        		jr	nc,send_status
407   FE58 1F           		rra			;send also byte
408   FE59 1F           		rra
409   FE5A 38 05        		jr	c,ld_pop_ret	;ZF=0 CY=1 line occupied, byte was not sent
410   FE5C ED 59        		out	(c),e		;NC= line free, byte was sent
411   FE5E 11           		db	#11		;#11 = ld de,<16-bit-number> = jump over "and <8bit)"
412   FE5F
413   FE5F E6 02        send_status	and	#01 << status_busy	;CY=0, Z = line free for transmit, NZ = line occupied
414   FE61
415   FE61 7B           ld_pop_ret	ld	a,e
416   FE62 D1           		pop	de
