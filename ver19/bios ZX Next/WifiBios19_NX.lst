261   FDAE 21 E6 FF     		ld	hl,bios_id
262   FDB1 DD 2E 0C     		ld	lx,num_of_calls
263   FDB4 01 09 01     		ld	bc,vers
264   FDB7 C9           		ret
265   FDB8
266   FDB8 01 02 00     reset_wifi	ld	bc,NextREG02
267   FDBB ED 78        		in	a,(c)
268   FDBD CB FF        		set	7,a
269   FDBF ED 79        		out	(c),a
270   FDC1 CB BF        		res	7,a
271   FDC3 ED 79        		out	(c),a
272   FDC5 C9           		ret
