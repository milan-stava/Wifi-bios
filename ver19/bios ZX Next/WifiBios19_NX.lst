284   FDCA
285   FDCA              ;; Clear receive buffer
286   FDCA
287   FDCA 3E 13        clear_loop	ld	a,high TX_CHKREADY
288   FDCC DB 3B        		in	a,(low TX_CHKREADY)
289   FDCE 0F           		rrca
290   FDCF D0           		ret	nc
291   FDD0 3E 14        		ld	a,high RX_SETBAUD
292   FDD2 DB 3B        		in	a,(low RX_SETBAUD)
293   FDD4 18 F4        		jr	clear_loop
294   FDD6
295   FDD6 18 5E        reloc1		jr	reloc2
296   FDD8
297   FDD8              ;; Set/Get baud rate
298   FDD8
299   FDD8 1E 00        set_baud_rate	ld	e,#00		;; We have 15 speeds on ESP01 in ZX Next so far
300   FDDA 43           		ld	b,e		;; in case of error speed 0 will be returned
301   FDDB 4B           		ld	c,e
302   FDDC CB 1A        		rr	d		;; Bit 7,d: 0=Info / 1=Set
303   FDDE 6F           		ld	l,a		;; L = requested speed index
304   FDDF 3E 55        max_index	ld	a,#55		;; A = max supported speed index (14 by default)
305   FDE1 BD           		cp	l
306   FDE2 D8           		ret	c		;; Return with CY=1 if speed index overflows max speed
307   FDE3 E5           		push	hl		;; L= speed index (0-14)
308   FDE4 7D           		ld	a,l
309   FDE5
310   FDE5 16 00        			LD D,0
311   FDE7 CB 27        			SLA A		; *2
312   FDE9 CB 12        			RL D
313   FDEB CB 27        			SLA A		; *4
314   FDED CB 12        			RL D
315   FDEF CB 27        			SLA A		; *8
316   FDF1 CB 12        			RL D
317   FDF3 CB 27        			SLA A		; *16
318   FDF5 CB 12        			RL D
319   FDF7 5F           			LD E,A
320   FDF8 21 C7 FE     add_spdtab1		LD HL,BaudPrescale	; HL now points at the BAUD to use.
321   FDFB 19           			ADD HL,DE
322   FDFC
323   FDFC 01 3B 24     			LD BC,9275	;Now adjust for the set Video timing.
324   FDFF 3E 11        			LD A,17
325   FE01 ED 79        			OUT (C),A
326   FE03 01 3B 25     			LD BC,9531
327   FE06 ED 78        			IN A,(C)	;get timing adjustment
328   FE08 5F           			LD E,A
329   FE09 CB 03        			RLC E		;*2 guaranteed as <127
330   FE0B 16 00        			LD D,0
331   FE0D 19           			ADD HL,DE
332   FE0E
333   FE0E 5E           			LD E,(HL)
334   FE0F 23           			INC HL
335   FE10 56           			LD D,(HL)
336   FE11 EB           			EX DE,HL
337   FE12
338   FE12              ;			PUSH HL		; This is prescaler, not needed
339   FE12              ;			PUSH AF		; and value, not needed
340   FE12
341   FE12 01 3B 14     			LD BC,RX_SETBAUD
342   FE15 7D           			LD A,L
343   FE16 E6 7F        			AND %01111111	; Res BIT 7 to request write to lower 7 bits
344   FE18 ED 79        			OUT (C),A
345   FE1A 7C           			LD A,H
346   FE1B CB 15        			RL L		; Bit 7 in Carry
347   FE1D 17           			RLA		; Now in Bit 0
348   FE1E F6 80        			OR %10000000	; Set MSB to request write to upper 7 bits
349   FE20 ED 79        			OUT (C),A
350   FE22
351   FE22 D1           		pop	de		;E=speed index 0-14, now we want to return set speed in BC:E
352   FE23 21 B9 FF     add_spdtab2	ld	hl,spdtab1
353   FE26 43           		ld	b,e
354   FE27 04           		inc	b
355   FE28 23           loop_read	inc	hl
356   FE29 23           		inc	hl
357   FE2A 23           		inc	hl
358   FE2B 10 FB        		djnz	loop_read
359   FE2D
360   FE2D 2B           read_item	dec	hl		;; HL = found item in baud speed table
361   FE2E 5E           		ld	e,(hl)
362   FE2F 2B           		dec	hl
363   FE30 46           		ld	b,(hl)
364   FE31 2B           		dec	hl		;; Output:
365   FE32 4E           		ld	c,(hl)		;;  BC:E = Baud rate (0 if speed not supported)
366   FE33 C9           		ret			;;  D = index of speed in BC:E (#FF = not valid)
