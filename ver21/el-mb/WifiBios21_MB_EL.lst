# file opened: WifiBios21_MB_EL.a80
  1   0000              ;; Wifi Bios for ESP 01- MB03+ and eLeMeNt ZX
  2   0000              ;; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  3   0000              ;; Written by Busy & Hood
  4   0000              ;; Consultations & acknowldgements & ideas: LMN, Lanex, Shrek, "Uart" authors (from Specnext)
  5   0000
  6   0000
  7   0000              ;zmeny ve verzi 2.1 oproti 2.0 (2026-11-05):
  8   0000              ;- get_baud_rate: FF je koncova znacka, nikdy platny index rychlosti 24.
  9   0000              ;- send_byte: stavovy dotaz NC vraci CY podle TX busy; A se zachovava.
 10   0000              ;- rece_block/send_block: BC=0 je prazdny blok, bez I/O, navrat CY=1.
 11   0000              ;- wifi_on/off: pri detekovanem eLeMeNtu zadny pristup k MB power portum.
 12   0000              ;  eLeMeNt zustava zapnuty (wifi_on NZ), vypnout nelze (wifi_off Z).
 13   0000              ;- opraven popis Z/NZ, registru a skutecneho timeoutu send_block.
 14   0000              ;- tabulka vstupu +00..+22 zustava stejna; instalaci je stale nutne volat.
 15   0000              ;- uspora: prime relativni skoky misto dvou zbytecnych JR mezistupnu.
 16   0000              ;- jde stale o MB03+/eLeMeNt backend, nikoli o BIOS pro ZX Next.
 17   0000              ;zmeny ve verzi 2.0. oproti 1.9:
 18   0000              ;jeden bios pro obe wifi (el i mb)
 19   0000              ;get_version_install	- natvrdo dava rychlost 23
 20   0000              ;			- nevycita core do reg DE
 21   0000              ;			- do registru E se dava 0 nebo NZ, pokud se ne/detekovalo MB03+, viz nize
 22   0000              ;turnon_wifi		- uprava- meni jen jeden bit, ne cely bajt
 23   0000              ;turnof_wifi		- po staru <2.0: vystup byl irelevantni, nove v 2.0: Z=wifi nemuze byt vypnuta, jde o elementi wifi, ktera nema vypinani, NZ=wifi vypnuta (jde o mb wifi, ktera muze byt vypnuta)
 24   0000
 25   0000
 26   0000              ;; ver 1.0 - 14.02.2020 - starting version
 27   0000              ;; ver 1.1 - 11.03.2020 - "turnon_wifi" routine updated, now correctly turns on the wifi module
 28   0000              ;; ver 1.2 - 30.04.2020 - New port layout and relocations of absolute addresses
 29   0000              ;; ver 1.3 - 25.05.2020 - new Wifi speeds added to "set_baud_rate"
 30   0000              ;; ver 1.4 - 03.06.2020 - new Wifi speeds added to "set_baud_rate"
 31   0000              ;;			- timeout added to "rece_block"
 32   0000              ;;			- "set_baud_rate" returns set Uart speed (as described in HW spec)
 33   0000              ;;			- "get_version_instal" returns core version
 34   0000              ;;			- "wifi_on" routine simplified
 35   0000              ;; ver 1.5 -		- release
 36   0000              ;; ver 1.6 - 18.3.2021	- "send_block- fix: now running correctly
 37   0000              ;;			- "send_block" and "rece_block" changes:
 38   0000              ;;					- key test routine removed for higher speed
 39   0000              ;;					- reg A status removed on output
 40   0000              ;;					- C/NC added on output
 41   0000              ;;			- "turnon_wifi": turns wifi on, or returns wifi state (without setting it on)
 42   0000              ;; ver 1.7 - 08.04.2021	- "get_version_install": MB03+ FW detection added-> max possible speed returned
 43   0000              ;;			- "set_baud_rate": - supported speed info returned with respect to MB03+ FW
 44   0000              ;;					   - minor bugfix
 45   0000              ;; ver 1.8 - 25.4.2021	- "set_baud_rate": - rewritten
 46   0000              ;;			- new routine GET_BAUD
 47   0000              ;;
 48   0000              ;; ver 1.9 - 9.12.2023	- added: g_zxi_0 set to external (to avoid collision with internal Wifi module in eLeMeNt ZX)
 49   0000              ;;			- added: fast clear receive buffer (new feature of MB core)
 50   0000              ;; ver 2.0 - 23.11.2025	- for coorection function of wifi bios always call "get_version_install" at the beginning
 51   0000              ;;			- fixed turnon wifi, removed device select. Only 1 bit set when turning wifi on.
 52   0000              ;;			- "get version instal" returns in E if mb was detected E= NZ=connected, E= 0=not connected, meaning el wifi is in usage.
 53   0000              ;;			- gives back speed 23 always
 54   0000              ;;			- turnon_wifi: changes just one bit, not a whole byte
 55   0000              ;;			- turnoff_wifi: new-OUT gives Z/NZ (Z= wifi cannot be turned off, NZ= wifi can be turned off)
 56   0000
 57   0000
 58   0000              vers	equ	#0201	;; Bios version: high byte = major number, low byte = minor number
 59   0000
 60   0000
 61   0000              ;; Used services
 62   0000              ;; ~~~~~~~~~~~~~
 63   0000              ;; +00 get_version_install: Get info about this bios, core version
 64   0000              ;;                          and install bios (in case of non relocatable code)
 65   0000              ;;                            INP: nothing
 66   0000              ;;                            OUT: HL = text version
 67   0000              ;;                                 BC = version number
 68   0000              ;;                                 A = max speed supported by MB03+ FW and bios (23 set as default)
 69   0000              ;;				   E = NZ=MB03+ detected, Z=MB03+ not detected
 70   0000              ;;				   LX = number of calls (bios routines)
 71   0000              ;;
 72   0000              ;; +04 turnon_wifi:         Turns Wifi module on
 73   0000              ;;				INP: NC = get status only, C = get status+ turn wifi on
 74   0000              ;;                            OUT: MB status NC: Z=off, NZ=on; set CY: NZ=on
 75   0000              ;;                                 EL: NZ=always on, no MB power port access
 76   0000              ;;
 77   0000              ;;
 78   0000              ;; +06 turnoff_wifi:        Turns MB Wifi module off
 79   0000              ;;                            INP: nothing
 80   0000              ;;                            OUT: NZ=ok, success, Z= MB wifi not detected, el wifi in usage and cannot be turned off
 81   0000              ;;
 82   0000              ;; +08 set_baud_rate:       Get info about supported communication speeds
 83   0000              ;;                          or set selected communication speed
 84   0000              ;;                            INP: CY: 0 = get speed info only, 1 = set speed into HW
 85   0000              ;;                                 reg A = index of speed 0..23, 0=slowest, 23=fastest
 86   0000              ;;                                         Note: Index is not OUT value defined in HW !
 87   0000              ;;                            OUT: CY = 1: Error, speed not supported (returns BC:E = 0)
 88   0000              ;;                                 CY = 0: OK, BC:E = speed in Bauds, corresponding with input index in A
 89   0000              ;;
 90   0000              ;; +10 get_baud_rate:      Returns current uart speed
 91   0000              ;;                            INP: none
 92   0000              ;;                            OUT: CY: 1 = speed reading not supported by FW, BC:E = 0, A = invalid (A=#FF)
 93   0000              ;;				   CY: 0 = OK, in this case:
 94   0000              ;;				           A = index of current speed as defined in bios index speed (0-23)
 95   0000              ;;                                         BC:E = speed in Bauds,corresponding with bios index speed (0-23)
 96   0000              ;;
 97   0000              ;;                            Encoding Baud speed in registers BC:E for  set_baud_rate and get_baud_rate
 98   0000              ;;                                 Speed = BC * 10 ^ E
 99   0000              ;;                                 BC = E = 0 if speed not supported
100   0000              ;;                                 Examle: BC=1152,E=2 ... Speed = 1152*10^2 = 115200 Bd
101   0000              ;;
102   0000              ;; +12 clear_receive_buffer: Resets FIFO to empty state
103   0000              ;;                            INP: nothing
104   0000              ;;                            OUT: nothing
105   0000              ;;
106   0000              ;; +16 rece_byte:           Get receive status or receive one byte
107   0000              ;;                            INP: CY: NC = get status only,
108   0000              ;;                                      C = get one byte from FIFO buffer
109   0000              ;;                            OUT: Z:  Indication of emptyness of FIFO
110   0000              ;;                                      Z = no byte to receive
111   0000              ;;                                     NZ = byte available; A=byte only after actual CY=1 read
112   0000              ;;                                 CY: Indication of fullness of FIFO
113   0000              ;;                                     NC = buffer ok, no data lost
114   0000              ;;                                      C = overflowed and data may be lost
115   0000              ;;
116   0000              ;; +18 send_byte:           Get send status or send one byte
117   0000              ;;                            INP: CY: NC = get status only
118   0000              ;;                                      C = send one byte
119   0000              ;;                                 reg A = byte to send (if CY=1)
120   0000              ;;                            OUT: CY: NC = line free, next byte can be send
121   0000              ;;                                      C = line occupied, next byte cannot be send; A is preserved
122   0000              ;;
123   0000              ;; +20 rece_block:          Receive block of more bytes
124   0000              ;;                            INP: HL = address to store received data
125   0000              ;;                                 BC = requested byte count; 0 = empty block (CY=1, no I/O)
126   0000              ;;                                 DE = timeout (range 0- #FFFF)
127   0000              ;;                            OUT: HL = address after really read data
128   0000              ;;                                 BC = number of missing bytes (not received yet) 0 = OK
129   0000              ;;                                 C= data received OK, NC= incomplete reception
130   0000              ;;
131   0000              ;; +22 send_block:          Send block of more bytes
132   0000              ;;                            IN: HL = address of data to send
133   0000              ;;                                BC = length of data to send; 0 = empty block (CY=1, no I/O)
134   0000              ;;                                DE = attempt counter; 0 gives 65535 attempts, not infinite
135   0000              ;;                                 DE and alternate DE are clobbered
136   0000              ;;                           OUT: HL = address after really send data
137   0000              ;;                                BC = number of missing bytes (not send yet) 0 = OK
138   0000              ;;                                C= data sent OK, NC= data not sent ok
139   0000              ;;
140   0000              ;; Services backup all needed registers
141   0000
142   0000              ;; Hardware definitions
143   0000              ;; ~~~~~~~~~~~~~~~~~~~~
144   0000              ;;
145   0000              ;; Hardware type: ESP01 integrated in MB03
146   0000              ;;
147   0000              ;; Supported speeds as described in MB03+ HW specification:
148   0000              ;;
149   0000              ;; Out   Speed
150   0000              ;; ===   =====
151   0000              ;;   0 = 115200  (default at reset)
152   0000              ;;   1 = 57600
153   0000              ;;   2 = 38400
154   0000              ;;   3 = 31250
155   0000              ;;   4 = 19200
156   0000              ;;   5 = 9600
157   0000              ;;   6 = 4800
158   0000              ;;   7 = 2400
159   0000              ;;   8 = 230400
160   0000              ;;   9 = 460800
161   0000              ;;  10 = 576000
162   0000              ;;  11 = 921600
163   0000              ;;  12 = 1152000
164   0000              ;;  13 = 1500000
165   0000              ;;  14 = 2000000
166   0000              ;;  15 = 2304000
167   0000              ;;  16 = 3456000
168   0000              ;;  17 = 4608000
169   0000              ;;  18 = 5760000
170   0000              ;;  19 = 6912000
171   0000              ;;  20 = 8064000
172   0000              ;;  21 = 9216000
173   0000              ;;  22 = 10368000
174   0000              ;;  23 = 11520000
175   0000              ;;
176   0000              ;; Size of the read (RX) FIFO buffer is 2048 bytes.
177   0000              ;;	The Wi-Fi specification is compatible with the ZX Spectrum Next. More info on websites:
178   0000              ;;     https://specnext.dev/wiki/ESP8266-01
179   0000              ;;     https://www.specnext.com/the-next-on-the-network/
180   0000              ;;     https://www.espressif.com/sites/default/files/documentation/4a-esp8266_at_instruction_set_en.pdf
181   0000              ;; The ports are h143B = 5179 for RX and h133B = 4923 for TX.
182   0000              ;; A write to the RX port configures the UART speed:
183   0000              ;;     0 = 115200 (default at reset); 1 = 57600; 2 = 38400; 3 = 31250; 4 = 19200; 5 = 9600; 6 = 4800; 7 = 2400;
184   0000              ;;     8 = 230400;  9 = 460800; 10= 576000; 11 = 921600; 12 = 1152000; 13=1_500_000; 14=2_000_000; 15=2_304_000;
185   0000              ;;     16=3_456_000; 17=4_608_000; 18=5_760_000; 19=6_912_000; 20=8_064_000;  21=9_216_000;
186   0000              ;;     22=10_368_000; 23=11_520_000
187   0000              ;; A read from the TX port shows the status of the FIFO buffer and the TX line:
188   0000              ;;     bit 0: RX status: '0' if the buffer is empty, '1' if there is a data to be collected.
189   0000              ;;     bit 1: TX status: '1' when the TX still transmitting the last byte or '0' when the TX is idle.
190   0000              ;;     bit 2: RX status: '1' if the buffer is full,  '0' when the buffer has space to hold.
191   0000              ;;     bit 3: RX status: '0' if the buffer is almost empty, '1' when the buffer has 256 or more bytes.
192   0000              ;;     bit 4: RX status: '1' if the buffer is almost full (contains 1024 bytes or more), '0' when the buffer has space to hold.
193   0000              ;;     zxi_105 - UART speed config (port #723B)- read gets current UART speed written to port h143B, not used in 2.0. g_zxi_030 used instead
194   0000
195   0000
196   0000              status_data1	=	0	;; RX buffer contains at least 1 received byte
197   0000              status_busy	=	1
198   0000              status_full	=	2
199   0000              status_data256	=	3	;; RX buffer contains at least 256 received bytes
200   0000              status_free256	=	4
201   0000
202   0000              mb03_port	equ	#703B
203   0000              Uart_speed_port	equ	#723B
204   0000              ZXi_port6	equ	#763B
205   0000              ZXi_port7	equ	#773B
206   0000              general_port	equ	#7C3B
207   0000              element_port	equ	#783B
208   0000
209   0000
210   0000              TX_CHKREADY	equ	#133B	;; Write: bytes to send    Read: status bits
211   0000              RX_SETBAUD	equ	#143B	;; Write: set baud rate    Read: received byted
212   0000
