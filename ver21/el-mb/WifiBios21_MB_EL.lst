404   FED1 23           search_loop	inc	hl
405   FED2 23           		inc	hl
406   FED3 23           		inc	hl
407   FED4 23           		inc	hl
408   FED5 14           		inc	d
409   FED6 CB 7E        		bit	7,(hl)		;test sentinel BEFORE comparing HW code
410   FED8 20 05        		jr	nz,spd_invalid
411   FEDA BE           		cp	(hl)
412   FEDB 20 F4        		jr	nz,search_loop
413   FEDD 18 02        		jr	spd_found	;valid match: CY=0, Z=1
