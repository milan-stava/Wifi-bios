# file opened: WifiBios21_NX.a80
  1   0000              ;; BIOS 2.1 ZX Next - 05.11.2026, derived from WifiBios19_NX.a80.
  2   0000              ;; Changes: safe real NextREG reset (also resets expansion bus), >=1ms pulse;
  3   0000              ;; baud info is read-only, compact index*16, timing masked to 0..7;
  4   0000              ;; select ESP and clear upper prescaler bits on baud write; initial 8N1;
  5   0000              ;; remove bulky 256-byte shortcut for size (Next bit 3 is near-full, not >=256);
  6   0000              ;; zero-length blocks return CY=1 without I/O; TX status returns correct CY;
  7   0000              ;; successful TX preserves A; unsupported baud read returns A=FF, BC:E=0;
  8   0000              ;; relocate BIOS identifier; DE=0 for unimplemented core version.
  9   0000              ;; ABI offsets unchanged. UART ownership: installation selects ESP, subsequent
 10   0000              ;; byte/block calls assume no other code switches UART to Pi or changes framing.
 11   0000              ;; Requires modern Next UART control/frame ports. No MB/eLeMeNt ports used.
 12   0000              ;; DE timeout is a polling budget, not milliseconds; TX DE=0 means 65535 polls.
 13   0000              ;; RX A is valid only on actual byte read (input CY=1, output NZ).
 14   0000              ;; Original 1.9 remains unchanged. See REVIEW_2.1.md and test_bios21_next.ps1.
 15   0000
 16   0000              ;; Wifi Bios for ESP 01- ZX Next
 17   0000              ;; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 18   0000
