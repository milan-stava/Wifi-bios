 37   0000              ;; Earlier version history below was inherited from the MB/eLeMeNt branch.
 38   0000
 39   0000              ;; ver 1.0 - 14.02.2020 - starting version
 40   0000              ;; ver 1.1 - 11.03.2020 - "turnon_wifi" routine updated, now correctly turns on the wifi module
 41   0000              ;; ver 1.2 - 30.04.2020 - New port layout and relocations of absolute addresses
 42   0000              ;; ver 1.3 - 25.05.2020 - new Wifi speeds added to "set_baud_rate"
 43   0000              ;; ver 1.4 - 03.06.2020 - new Wifi speeds added to "set_baud_rate"
 44   0000              ;;			- timeout added to "rece_block"
 45   0000              ;;			- "set_baud_rate" returns set Uart speed (as described in HW spec)
 46   0000              ;;			- "get_version_instal" returns core version
 47   0000              ;;			- "wifi_on" routine simplified
 48   0000              ;; ver 1.5 -		- release
 49   0000              ;; ver 1.6 - 18.3.2021	- "send_block- fix: now running correctly
 50   0000              ;;			- "send_block" and "rece_block" changes:
 51   0000              ;;					- key test routine removed for higher speed
 52   0000              ;;					- reg A status removed on output
 53   0000              ;;					- C/NC added on output
 54   0000              ;;			- "turnon_wifi": turns wifi on, or returns wifi state (without setting it on)
 55   0000              ;; ver 1.7 - 08.04.2021	- "get_version_install": MB03+ FW detection added-> max possible speed returned
 56   0000              ;;			- "set_baud_rate": - supported speed info returned with respect to MB03+ FW
 57   0000              ;;					   - minor bugfix
 58   0000              ;; ver 1.8 - 25.4.2021	- "set_baud_rate": - rewritten
 59   0000              ;;			- new routine GET_BAUD
 60   0000              ;; ver 1.9 - 9.12.2023	- added: g_zxi_0 set to external (to avoid collision with internal Wifi module in eLeMeNt ZX)
 61   0000              ;;			- added: fast clear receive buffer (new feature of MB core)
 62   0000              ;;			- added: turn off Wifi module in MB03+
 63   0000
 64   0000
 65   0000
 66   0000              vers	equ	#0201	;; Bios version: high byte = major number, low byte = minor number
 67   0000              ;seladd	equ	0	;; Select port addresses: 0=#2X3B, 1=#7X3B
 68   0000
 69   0000              ;; Used services
 70   0000              ;; ~~~~~~~~~~~~~
 71   0000              ;; +00 get_version_install: Get info about this bios, (core version not implemented)
 72   0000              ;;                          and install bios (in case of non relocatable code)
 73   0000              ;;                            INP: nothing
 74   0000              ;;                            OUT: HL = text version
 75   0000              ;;                                 BC = version number
 76   0000              ;;                                 A = maximum BIOS speed index (14 = 2000000 baud)
 77   0000              ;;				   DE = 0 (core version not implemented)
 78   0000              ;;				   LX = number of calls (bios routines)
 79   0000              ;;
 80   0000              ;; +02 reset_wifi: Resets ESP AND expansion bus via NextReg 02 bit 7.
 81   0000              ;;				INP: nothing
 82   0000              ;;				OUT: nothing
 83   0000              ;;
 84   0000              ;; +04 turnon_wifi:         Reports NZ (power switching unavailable).
 85   0000              ;;				INP: NC = get status only, C = get status+ turn wifi on
 86   0000              ;;				OUT: Z= wifi is off, NZ= wifi is on
 87   0000              ;;
 88   0000              ;;
 89   0000              ;; +06 turnoff_wifi:        No operation (power switching unavailable).
 90   0000              ;;                            INP: nothing
 91   0000              ;;                            OUT: nothing
 92   0000              ;;
 93   0000              ;; +08 set_baud_rate:       Get info about supported communication speeds
 94   0000              ;;                          or set selected communication speed
 95   0000              ;;                            INP: CY: 0 = get speed info only, 1 = set speed into HW
 96   0000              ;;                                 reg A = index of speed 0..14, 0=slowest, 14=fastest
 97   0000              ;;                                         Note: Index is not OUT value defined in HW !
 98   0000              ;;                            OUT: CY = 1: Error, speed not supported (returns BC:E = 0)
 99   0000              ;;                                 CY = 0: OK, BC:E = speed in Bauds, corresponding with input index in A
100   0000              ;;
101   0000              ;; +10 get_baud_rate:      Unsupported in this BIOS; always CY=1, A=FF, BC:E=0.
102   0000              ;;                            INP: none
103   0000              ;;                            OUT: CY: 1 = speed reading not supported by FW, BC:E = 0, A = invalid (A=#FF)
104   0000              ;;				   CY: 0 = OK, in this case:
105   0000              ;;				           A = index of current speed as defined in bios index speed (0-14)
106   0000              ;;                                         BC:E = speed in Bauds,corresponding with bios index speed (0-14)
107   0000              ;;
108   0000              ;;                            Encoding Baud speed in registers BC:E for  set_baud_rate and get_baud_rate
109   0000              ;;                                 Speed = BC * 10 ^ E
110   0000              ;;                                 BC = E = 0 if speed not supported
111   0000              ;;                                 Examle: BC=1152,E=2 ... Speed = 1152*10^2 = 115200 Bd
112   0000              ;;
113   0000              ;; +12 clear_receive_buffer: Resets FIFO to empty state
114   0000              ;;                            INP: nothing
115   0000              ;;                            OUT: nothing
116   0000              ;;
117   0000              ;; +16 rece_byte:           Get receive status or receive one byte
118   0000              ;;                            INP: CY: NC = get status only,
119   0000              ;;                                      C = get one byte from FIFO buffer
120   0000              ;;                            OUT: Z:  Indication of emptyness of FIFO
121   0000              ;;                                      Z = no byte to receive
122   0000              ;;                                     NZ = byte available; A valid only if input CY=1
123   0000              ;;                                 CY: Indication of FIFO overflow (latched, cleared by status read)
124   0000              ;;                                     NC = buffer ok, no data lost
125   0000              ;;                                      C = overflowed and data may be lost
126   0000              ;;
127   0000              ;; +18 send_byte:           Get send status or send one byte
128   0000              ;;                            INP: CY: NC = get status only
129   0000              ;;                                      C = send one byte
130   0000              ;;                                 reg A = byte to send (if CY=1)
131   0000              ;;                            OUT: CY: NC = line free, next byte can be send
132   0000              ;;                                      C = line occupied, next byte cannot be send
133   0000              ;;
134   0000              ;; +20 rece_block:          Receive block of more bytes
135   0000              ;;                            INP: HL = address to store received data
136   0000              ;;                                 BC = number of requested bytes (0 = empty block)
137   0000              ;;                                 DE = timeout (range 0- #FFFF)
138   0000              ;;                            OUT: HL = address after really read data
139   0000              ;;                                 BC = number of missing bytes (not received yet) 0 = OK
140   0000              ;;                                 CY=1 complete, CY=0 timeout
141   0000              ;;
142   0000              ;; +22 send_block:          Send block of more bytes
143   0000              ;;                            IN: HL = address of data to send
144   0000              ;;                                BC = length  of data to send
145   0000              ;;                                DE = polling budget (0 = 65535 attempts); DE/DE' changed
146   0000              ;;                           OUT: HL = address after really send data
147   0000              ;;                                BC = number of missing bytes (not send yet) 0 = OK
148   0000              ;;                                CY=1 complete, CY=0 timeout
149   0000              ;;
150   0000              ;; Byte calls preserve BC/DE; other registers are scratch unless specified.
151   0000
152   0000              ;; Hardware definitions
153   0000              ;; ~~~~~~~~~~~~~~~~~~~~
154   0000              ;;
155   0000              ;; Hardware: ZX Spectrum Next ESP UART, exclusively owned after installation.
156   0000              ;; RX status bit 0=data, bit 2=overflow (clears on status read).
157   0000              ;; TX status bit 1=FIFO full (not transmitter busy); bit 4=FIFO empty.
158   0000              ;; Bit 3=RX near-full, NOT MB >=256-byte indication. No fixed FIFO size assumed.
159   0000              ;; Baud divider = system master clock / requested baud; eight timing columns.
160   0000              ;; Port 153B selects ESP and writes upper divider bits; 163B configures frame.
161   0000              ;; Sources: https://wiki.specnext.dev/UART_TX , /UART_RX , /UART_Control
162   0000              ;;          https://wiki.specnext.dev/UART_Frame , /Reset_Register
163   0000              status_data1 equ 0
164   0000              status_busy equ 1
165   0000              status_full equ 2
166   0000
167   0000
168   0000              TX_CHKREADY	equ	#133B	;; Write: bytes to send    Read: status bits
169   0000              RX_SETBAUD	equ	#143B	;; Write: set baud rate    Read: received byted
170   0000              NextREG02	equ	2
171   0000
