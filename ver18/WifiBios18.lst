331   FEA1 1E 00        set_baud_rate	ld	e,#00		;; We have 24 speeds on ESP01 in MB03 so far
332   FEA3 43           		ld	b,e		;; in case of error speed 0 will be returned
333   FEA4 4B           		ld	c,e
334   FEA5 CB 1A        		rr	d		;; Bit 7,d: 0=Info / 1=Set
335   FEA7 6F           		ld	l,a		;; L = requested speed index
336   FEA8 3E 55        max_index	ld	a,#55		;; A = max supported speed index (7,12,23)
337   FEAA BD           		cp	l
